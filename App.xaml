<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SQLiteEncrypted.MauiMaintenanceLog.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="PageBackground">#F6F3EA</Color>
      <Color x:Key="Evergreen">#12372F</Color>
      <Color x:Key="Teal">#0F766E</Color>
      <Color x:Key="Muted">#64748B</Color>
      <Style TargetType="Label">
        <Setter Property="TextColor" Value="#17211E" />
      </Style>
      <Style TargetType="Entry">
        <Setter Property="TextColor" Value="#17211E" />
        <Setter Property="PlaceholderColor" Value="#7B8581" />
        <Setter Property="BackgroundColor" Value="White" />
      </Style>
      <Style TargetType="Editor">
        <Setter Property="TextColor" Value="#17211E" />
        <Setter Property="PlaceholderColor" Value="#7B8581" />
        <Setter Property="BackgroundColor" Value="White" />
      </Style>
      <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Teal}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="10" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>

